<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- GC concurrent désactivé : il maintient un thread de fond et un budget
         mémoire supplémentaire, utiles pour une application interactive lourde,
         inutiles pour une icône de barre des tâches qui dort la quasi-totalité
         du temps. Le GC workstation non concurrent suffit et coûte moins. -->
    <gcConcurrent enabled="false" />
    <gcServer enabled="false" />
  </runtime>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
